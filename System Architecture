## 6. Schema Dati Applicativo (Zod Contract)

Contratto formale per l'output validato dal backend Node.js:

```typescript
import { z } from 'zod';

export const EvaluationOutputSchema = z.object({
  completeness_score: z.number().min(0).max(1),
  extracted_data: z.object({
    project_type: z.string(),
    scope_summary: z.string(),
    deadline: z.string().nullable(),
    commercial_rights_required: z.boolean(),
    client_budget: z.number().nullable()
  }),
  missing_fields: z.array(z.string()),
  risk_alerts: z.array(z.string()),
  suggested_price: z.object({
    min: z.number().nonnegative(),
    max: z.number().nonnegative(),
    currency: z.string().default('EUR'),
    justification: z.string()
  }),
  followup_email_draft: z.string()
});

export type EvaluationOutput = z.infer<typeof EvaluationOutputSchema>;
```

