## 5. Schema DDL Database (PostgreSQL)

```sql
-- Estensioni richieste per identificatori univoci e supporto vettoriale
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "vector";

-- 1. Memoria Storica: Preventivi passati emessi dall'artista
CREATE TABLE historical_quotes (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    code VARCHAR(30) UNIQUE NOT NULL,
    project_type VARCHAR(80) NOT NULL,
    client_type VARCHAR(50),
    scope_description TEXT NOT NULL,
    embedding vector(768) NOT NULL,
    base_price NUMERIC(10, 2) NOT NULL,
    currency VARCHAR(3) DEFAULT 'EUR',
    delivery_days INT,
    commercial_rights BOOLEAN DEFAULT FALSE,
    clauses JSONB DEFAULT '[]'::jsonb,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Indice HNSW per ricerca coseno su vettori
CREATE INDEX idx_historical_quotes_hnsw 
    ON historical_quotes USING hnsw (embedding vector_cosine_ops)
    WITH (m = 16, ef_construction = 64);

CREATE INDEX idx_historical_quotes_project_type 
    ON historical_quotes (project_type);

CREATE INDEX idx_historical_quotes_clauses_gin 
    ON historical_quotes USING gin (clauses);

-- 2. Richieste in Ingresso: Email e audio caricati
CREATE TABLE quote_requests (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    source_type VARCHAR(20) NOT NULL CHECK (source_type IN ('email', 'audio_note', 'combined')),
    raw_email_text TEXT,
    raw_audio_transcript TEXT,
    merged_text TEXT NOT NULL,
    embedding vector(768),
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Valutazioni & Audit Trail: Risultato elaborato da Gemma 2
CREATE TABLE quote_evaluations (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    request_id UUID NOT NULL REFERENCES quote_requests(id) ON DELETE CASCADE,
    completeness_score NUMERIC(3, 2) NOT NULL,
    extracted_data JSONB NOT NULL,
    missing_fields TEXT[] DEFAULT ARRAY[]::TEXT[],
    risk_alerts JSONB DEFAULT '[]'::jsonb,
    suggested_price_min NUMERIC(10, 2),
    suggested_price_max NUMERIC(10, 2),
    referenced_quote_ids UUID[],
    followup_email_draft TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_quote_evaluations_request_id 
    ON quote_evaluations (request_id);
```

