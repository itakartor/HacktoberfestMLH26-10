# Runtime
PORT=3000

# ElevenLabs realtime STT (Scribe v2 Realtime)
ELEVENLABS_API_KEY=
STT_LANGUAGE=it

# Persistence: vuoto = PostgreSQL embedded (PGlite + pgvector) in ./data/pgdata
# Per Postgres esterno (docker pgvector/pgvector:pg16) imposta DATABASE_URL
DATABASE_URL=

# Local Ollama Service
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma
LLM_MODEL=gemma4:e4b-it-qat
